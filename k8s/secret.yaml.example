# Template for k8s/secret.yaml. Copy it, fill in the values, apply it.
#
#   cp k8s/secret.yaml.example k8s/secret.yaml
#   # edit k8s/secret.yaml
#   kubectl apply -f k8s/secret.yaml
#
# k8s/secret.yaml is gitignored. This template is not, so never put a real value
# in this file.
#
# `stringData` takes plaintext and Kubernetes encodes it on write, so there is no
# base64 step. That is deliberate: the usual way this goes wrong is
# `echo 'sk-ant-...' | base64` without -n, which appends a newline and produces a
# token the API rejects with a confusing 401. If you prefer `data:` with
# pre-encoded values, that works too, but use `printf` or `echo -n`.
#
# Which of these you actually need depends on what you are running. Only
# ANTHROPIC_API_KEY is required; every other key is marked `optional: true` in
# deployment.yaml, so leaving one out leaves its env var unset rather than
# preventing the pod from starting.
apiVersion: v1
kind: Secret
metadata:
  name: sre-agent-secrets
  namespace: sre-agent
  labels:
    app.kubernetes.io/name: sre-agent
type: Opaque
stringData:
  # REQUIRED. The agent cannot do anything without this.
  # When routing through a model gateway (see ANTHROPIC_BASE_URL) this holds the
  # gateway key, which for the LangSmith gateway is an lsv2_sk_ value rather than
  # an sk-ant- one.
  ANTHROPIC_API_KEY: "REPLACE_ME"

  # Optional. Needed for trace export, and required by anything that talks to the
  # LangSmith dataset API: evals/run_eval.py, evals/upload_online_evals.py, and
  # recording findings to a dataset. Trace export alone used to be configured via
  # LANGSMITH_RUNS_ENDPOINTS, which does not authenticate the dataset client, so
  # this is the variable to set.
  LANGSMITH_API_KEY: "REPLACE_ME"

  # Optional. Route Claude calls through a model gateway, e.g.
  # https://gateway.smith.langchain.com/anthropic
  # Leave this out to call Anthropic directly.
  ANTHROPIC_BASE_URL: "REPLACE_ME"

  # Optional. Only useful if LANGSMITH_API_KEY is an organization-scoped personal
  # access token (rather than a workspace-scoped key), in which case the SDK
  # sends no workspace header and the server resolves the token's default
  # workspace — which may not be the one you want traces to land in. Leave this
  # out to use the token's default workspace.
  LANGSMITH_WORKSPACE_ID: "REPLACE_ME"

  # Optional and currently unused by any code path. deployment.yaml still
  # references it, so it is listed here for completeness. Gateway routing is
  # driven entirely by ANTHROPIC_BASE_URL plus the key in ANTHROPIC_API_KEY.
  LC_GATEWAY_KEY: "REPLACE_ME"

  # Optional. Without both of these the bot runs headless: no alerts, no health
  # reports, and no HITL approve/reject buttons. Approvals then have to come from
  # the web UI or the REST endpoints.
  #   SLACK_BOT_TOKEN needs chat:write and chat:write.public
  #   SLACK_APP_TOKEN needs connections:write (Socket Mode)
  SLACK_BOT_TOKEN: "xoxb-REPLACE_ME"
  SLACK_APP_TOKEN: "xapp-REPLACE_ME"

  # Optional, and only needed once the Postgres manifests are deployed. Without a
  # database the agent falls back to in-memory state: pending HITL approvals do
  # not survive a restart and monitoring keeps no history.
  #
  # Keep this ALPHANUMERIC. deployment.yaml interpolates it into DATABASE_URL as
  # postgresql://sre_agent:$(POSTGRES_PASSWORD)@... and a /, + or @ corrupts the
  # DSN. Generate one with:
  #   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40
  POSTGRES_PASSWORD: "REPLACE_ME"
