# === LLM ===
# Choose "anthropic" (default) or "openai".
LLM_PROVIDER=anthropic

# Anthropic configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_SUBAGENT_MODEL=claude-haiku-4-5-20251001
# LangChain model gateway key
LC_GATEWAY_KEY=your_lc_gateway_key_here
# Gateway endpoint for the Anthropic SDK (leave unset to hit Anthropic directly)
ANTHROPIC_BASE_URL=your_gateway_base_url_here

# OpenAI configuration (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol
OPENAI_SUBAGENT_MODEL=gpt-5.6-luna
# Optional OpenAI-compatible gateway endpoint; leave empty for OpenAI directly.
OPENAI_BASE_URL=

# === LangSmith tracing (required) ===
LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_RUNS_ENDPOINTS was a multi-endpoint trace fan-out (a JSON list of
# {api_url, api_key, project_name}). It authenticates trace export only, not the
# dataset client, so evals and finding capture could not use it. Single endpoint
# now; set LANGSMITH_API_KEY instead.
LANGSMITH_PROJECT=sre-agent
LANGSMITH_TRACING=true
LANGSMITH_WORKSPACE_ID=your_workspace_id_here

# === Slack ===
# Bot token (xoxb-...) — needs chat:write, chat:write.public scopes
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# App-level token (xapp-...) — for Socket Mode (connections:write scope)
SLACK_APP_TOKEN=xapp-your-app-token-here
# Channel to post alerts and health reports
SLACK_CHANNEL=#sre-alerts

# === Durable state ===
# Postgres DSN backing langgraph checkpoints, sessions, the HITL audit log, and
# monitoring finding-state. Leave EMPTY for local CLI use — the process falls
# back to in-memory state, but pending HITL approvals and monitoring history
# will not survive a restart.
#   docker run --rm -d -p 5432:5432 -e POSTGRES_PASSWORD=dev \
#     -e POSTGRES_USER=sre_agent -e POSTGRES_DB=sre_agent postgres:16-alpine
DATABASE_URL=

# === Monitoring schedule ===
# Whether the background scheduler runs at all.
MONITORING_ENABLED=true
# How often the bot autonomously checks the cluster (minutes)
MONITOR_INTERVAL_MINUTES=60
# Post to Slack only when the diff vs the previous check has something new,
# escalated, or newly resolved. These control the exceptions to that.
MONITOR_DIGEST_EVERY_N_CHECKS=12
MONITOR_NOTIFY_ON_RESOLVED=true
MONITOR_ACK_HOURS=24
# Only PVCs at or above this fill percentage are listed individually in the
# health snapshot; below it they are summarised as a count.
PVC_USAGE_ALERT_PERCENT=70
# Pod health is judged on current state, not cumulative restart count. A failed
# termination older than this is history rather than a live incident.
POD_FAILURE_RECENCY_MINUTES=60
# Grace period before Pending or not-ready counts as a fault, so pods that are
# merely still starting during a rollout are not reported.
POD_STARTUP_GRACE_MINUTES=10
# Lifetime restart counts at or above this are reported as context, never a fault.
POD_RESTART_NOTABLE=10
# Warning events older than this are dropped, as are events about pods that no
# longer exist.
EVENT_MAX_AGE_MINUTES=60

# === HITL authorization ===
# Comma-separated Slack user IDs (e.g. U123ABC,U456DEF) allowed to approve or
# reject cluster changes. EMPTY MEANS ANY workspace user who can see the message
# may approve. Set this to restrict approvals to your on-call rotation.
SLACK_APPROVER_IDS=

# === Kubernetes ===
# Leave empty to auto-discover all non-system namespaces
DEFAULT_NAMESPACES=

# === Optional ===
# Prometheus URL for richer metrics (leave empty to rely on metrics-server)
PROMETHEUS_URL=
API_PORT=8080
# Max characters any single tool result may add to the message history. Every
# other limit counts calls, not bytes, which is how a run reached a 632,740-token
# prompt against a 200,000 ceiling with all limits satisfied.
TOOL_OUTPUT_MAX_CHARS=12000
# Comma-separated browser origins allowed to call /api/*. Empty means none,
# which is correct for the bundled UI since it is served same-origin.
CORS_ALLOW_ORIGINS=
